' 20_textwindow.ds — a Unicode console replacement.
'
' A scrollable output pane on top, an editable multiline input pane below, and a
' Submit button. The window runs on its own thread with its own message loop, so
' it stays responsive while the script is busy and output appears as it is written.
'
' It fills the gap between MsgBox (one line, awkward to copy from) and the console
' (mangles anything outside its code page, no real editing). Windows only: the
' Linux build reports that rather than pretending.
Option Explicit

Dim tw : Set tw = New TextWindow
Dim con : Set con = New Console
Dim interactive
interactive = con.Attached Or InStr(LCase(Directive.FullName), "directivew") > 0

On Error Resume Next
tw.Title = "Directive — TextWindow"
If Err.Number <> 0 Then
    Directive.Echo "TextWindow: " & Err.Description
    Err.Clear
    Directive.Quit 0
End If
On Error Goto 0

If Not interactive Then
    Directive.Echo "TextWindow demo: run me from a console or with directivew.exe."
    Directive.Quit 0
End If

' ---- output -----------------------------------------------------------------
' The window appears on the first write.
tw.WriteLine "Anything the console cannot show, this can:"
tw.WriteLine "  Japanese  " & ChrW(12371) & ChrW(12435) & ChrW(12395) & ChrW(12385) & ChrW(12399)
tw.WriteLine "  Symbols   " & ChrW(177) & " " & ChrW(215) & " " & ChrW(247) & " " & ChrW(8804) & " " & ChrW(8734) & " " & ChrW(8364) & " " & ChrW(9733)
tw.WriteLine "  Accents   caf" & ChrW(233) & ", w" & ChrW(246) & "rld, stra" & ChrW(223) & "e"
tw.WriteLine ""
tw.WriteLine "A lone line feed is turned into a proper line break:" & dsLf & "  ...like this."
tw.WriteLine ""

' ---- input ------------------------------------------------------------------
' The user submits with the Submit button or Ctrl+Enter. Plain Enter inserts a
' newline, which is the point of a multiline input box. Set SubmitOnEnter = True
' to swap that round when reading one line at a time.
tw.SubmitOnEnter = True
Dim who : who = tw.Prompt("What is your name? ")
tw.WriteLine "Hello, " & who
tw.WriteLine ""

' ---- a prompt loop ----------------------------------------------------------
tw.WriteLine "Type a few commands, or 'quit' to finish."
Dim cmd
Do
    cmd = tw.Prompt("> ")
    If tw.IsClosed Then Exit Do
    If LCase(Trim(cmd)) = "quit" Then Exit Do
    tw.WriteLine "  you said: " & cmd
Loop

' ---- a log window with no input pane ----------------------------------------
tw.WriteLine ""
tw.WriteLine "Setting ShowInput = False turns this into an output-only log."
tw.ShowInput = False
Dim i
For i = 1 To 8
    tw.WriteLine "  processing item " & i
    Directive.Sleep 60
Next
tw.WriteLine ""
tw.WriteLine "Close the window when you are done."

tw.WaitForClose
Directive.Echo "window closed; the transcript was " & Len(tw.Text) & " characters"

' --- PAUSE (batch equivalent): only waits when this script owns the console, so a
' double-click stays readable while prompt/piped/GUI runs are unaffected.
Dim keepOpen : Set keepOpen = New Console : keepOpen.KeepOpen
