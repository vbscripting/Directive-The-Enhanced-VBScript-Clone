' 14_shell.ds
' The native Shell object (New Shell) — a cross-platform replacement for
' the classic Windows shell, so scripts keep working without depending on COM.

Dim sh
Set sh = New Shell

' --- Environment variables (cross-platform) ---
directive.echo "PATH is set: " & (Len(sh.Environment("PROCESS")("PATH")) > 0)
directive.echo "Expanded:    " & sh.ExpandEnvironmentStrings("home=%HOME%%USERPROFILE%")

' --- Current directory (cross-platform) ---
directive.echo "Working dir: " & sh.CurrentDirectory

' --- Exec: run a command and capture its output (cross-platform) ---
' (uses a shell command; adjust for your OS)
Dim e
Set e = sh.Exec("echo hello from the shell")
directive.echo "Exec says:   " & Trim(e.StdOut.ReadAll)
directive.echo "Exit code:   " & e.ExitCode

' --- Run: launch a program; wait = True blocks and returns the exit code ---
' Dim rc : rc = sh.Run("notepad.exe", 1, True)   ' Windows
' directive.echo "Run exit: " & rc

